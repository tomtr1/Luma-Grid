// LumaGrid build configuration shared by Debug and Release.
// Every value that may need to change before release lives here or in Debug/Release.xcconfig.
// Local secrets/overrides go in Config/Secrets.xcconfig (git-ignored; copy Secrets.example.xcconfig).
//
// NOTE: xcconfig treats "//" as a comment, so URLs must be written as  https:/$()/example.org/path

// App identity (working title; verify name/trademark availability before release)
LUMA_DISPLAY_NAME = LumaGrid
LUMA_BUNDLE_ID = com.example.lumagrid
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// StoreKit product identifier prefix. Products are <prefix>.removeforcedads, <prefix>.theme.nebula,
// <prefix>.theme.sunrise, <prefix>.coins.small, <prefix>.coins.large.
// Keep LumaGrid/Resources/LumaGrid.storekit in sync when changing this.
LUMA_PRODUCT_ID_PREFIX = com.example.lumagrid

// Public URLs. Leave empty until real pages exist: the app hides links that are not configured.
LUMA_PRIVACY_POLICY_URL =
LUMA_SUPPORT_URL =

// Google Mobile Ads. Overridden per configuration below and in Secrets.xcconfig.
LUMA_ADS_ENABLED = NO
LUMA_GAD_APP_ID =
LUMA_GAD_INTERSTITIAL_ID =
LUMA_GAD_REWARDED_ID =
