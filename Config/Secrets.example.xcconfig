// Copy to Config/Secrets.xcconfig (git-ignored) and fill in real values.
// Secrets.xcconfig is included last by Debug.xcconfig and Release.xcconfig, so it overrides them.
// Use conditional settings so Debug keeps Google's test IDs:

// LUMA_BUNDLE_ID = com.yourcompany.lumagrid
// LUMA_PRODUCT_ID_PREFIX = com.yourcompany.lumagrid
// DEVELOPMENT_TEAM = ABCDE12345

// LUMA_PRIVACY_POLICY_URL = https:/$()/yourdomain.example/lumagrid/privacy
// LUMA_SUPPORT_URL = https:/$()/yourdomain.example/lumagrid/support

// LUMA_ADS_ENABLED[config=Release] = YES
// LUMA_GAD_APP_ID[config=Release] = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
// LUMA_GAD_INTERSTITIAL_ID[config=Release] = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
// LUMA_GAD_REWARDED_ID[config=Release] = ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW
